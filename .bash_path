# =======================================================================
# GIT
# =======================================================================
GIT_WORKSPACE=~/github_workspace
GIT_REPO_DOTFILES=${GIT_WORKSPACE}/dotfiles
GIT_REPO_ETCFILES=${GIT_WORKSPACE}/etcfiles
GIT_REPO_PRVFILES=${GIT_WORKSPACE}/prvfiles

# =======================================================================
# HOME set
# =======================================================================
JAVA_HOME=/opt/java/jdk-11.0.5
JYTHON_HOME=/opt/jython/jython2.7.0
ECLIPSE_HOME=~/eclipse/jee-2019-09/enterprise_java_developers/eclipse
PYCHARM_HOME=/opt/pycharm/pycharm-community-2019.2.5/bin

# =======================================================================
# SSLKEY
# =======================================================================
SSLKEY_PUB_NONPASS=~/.ssh/daisuke6106.rsa4096.key.pub
SSLKEY_PRV_NONPASS=~/.ssh/daisuke6106.rsa4096.key
# =======================================================================
# OTHER
# =======================================================================
PRAWLER_HOME=${GIT_WORKSPACE}/prawler

# =======================================================================
# PYTHONPATH
# =======================================================================
export PYTHONPATH="${PRAWLER_HOME}:${PYTHONPATH}"

# JAVA
export PATH=${JAVA_HOME}/bin:${PATH}
# JYTHON
export PATH=${JYTHON_HOME}/bin:${PATH}
# ECLIPSE
export PATH=${ECLIPSE_HOME}:${PATH}
# Pycharm
export PATH=${PYCHARM_HOME}:${PATH}
# Prawler
export PATH=${PRAWLER_HOME}:${PATH}

# =======================================================================
# その他
# =======================================================================
# Windows10 - Git Bashでシンボリックリンクをつくれるようにする
# https://blog.logicky.com/2017/06/07/windows10-git-bash%E3%81%A7%E3%82%B7%E3%83%B3%E3%83%9C%E3%83%AA%E3%83%83%E3%82%AF%E3%83%AA%E3%83%B3%E3%82%AF%E3%82%92%E3%81%A4%E3%81%8F%E3%82%8C%E3%82%8B%E3%82%88%E3%81%86%E3%81%AB%E3%81%99%E3%82%8B/
