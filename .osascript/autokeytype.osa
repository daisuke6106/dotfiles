#!/usr/bin/osascript
-- ==================================================================================================
-- 自動キータイプスクリプト
-- 
-- アクティブになっている画面に大して無限に５秒に１回「a」を打ち続けます
-- 
-- ==================================================================================================
-- set count to (text returned of (display dialog "繰り返し回数を入力" default answer "10")) as number
tell application "System Events"
  -- ==================================================================================================
  -- ループ開始
  -- ==================================================================================================
  repeat             -- 無限ループ
  -- repeat count times -- 指定回数リピート

    -- ==================================================================================================
    -- 最前面のアプリ取得
    -- ==================================================================================================
    set frontApp to name of every process whose frontmost is true
    set frontApp to item 1 of frontApp
    
    tell process frontApp
      set frontmost to true
      key code 0 -- aをタイプする。
      delay 5 -- 小休止。5秒
    end tell
  end repeat
end tell
